<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>winDeployAgent-Setup</OutputName>
    <OutputType>Package</OutputType>
      <InstallerPlatform>x64</InstallerPlatform>
      <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.1.0</ProductVersion>
    <SuppressValidation>true</SuppressValidation>
      <DefineConstants>AgentPublishDir=$(MSBuildThisFileDirectory)..\..\artifacts\win-x64;ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
</Project>
