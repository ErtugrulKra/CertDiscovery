@model IReadOnlyList<CertificateDiscovery.Contracts.DeploymentAgentExchangeDto>
@using CertificateDiscovery.Contracts
@using CertificateDiscovery.Domain
@{
    ViewData["Title"] = "Deployment Agents";
    var agents = ViewBag.Agents as IReadOnlyList<DeploymentAgentDto> ?? [];
}
<div class="page-heading">
    <div><h2>Deployment Agents</h2><p>Approve first-run registration requests and inspect registered Microsoft IIS agents.</p></div>
</div>
@if (TempData["AgentMessage"] is string message) { <div class="alert alert-success">@message</div> }
@if (TempData["AgentError"] is string error) { <div class="alert alert-danger">@error</div> }

<section class="panel">
    <div class="panel-header"><h2>Pending registration exchanges</h2></div>
    <div class="table-responsive"><table class="table table-sm">
        <thead><tr><th>Approval code</th><th>Agent / machine</th><th>Public key fingerprint</th><th>Status</th><th>Expires</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><code>@item.UserCode</code></td>
                <td>@item.Name<br/><small class="text-muted">@item.MachineName · @item.OperatingSystem</small></td>
                <td><code class="text-break">@item.PublicKeyFingerprint</code></td>
                <td>@item.Status</td>
                <td>@item.ExpiresAtUtc.ToLocalTime().ToString("g")</td>
                <td class="text-end">
                    @if (item.Status == DeploymentAgentExchangeStatus.Pending)
                    {
                        <form method="post" asp-action="Approve" asp-route-id="@item.Id" class="d-inline"><button class="btn btn-sm btn-primary">Approve</button></form>
                        <form method="post" asp-action="Reject" asp-route-id="@item.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Reject</button></form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-muted">No registration exchanges.</td></tr> }
        </tbody>
    </table></div>
</section>

<section class="panel">
    <div class="panel-header"><h2>Registered agents</h2></div>
    <div class="table-responsive"><table class="table table-sm">
        <thead><tr><th>Name</th><th>Machine</th><th>Status</th><th>Version</th><th>Last heartbeat</th></tr></thead>
        <tbody>
        @foreach (var agent in agents)
        {
            <tr><td>@agent.Name</td><td>@agent.MachineName</td><td>@agent.Status</td><td>@agent.Version</td><td>@agent.LastHeartbeatAtUtc.ToLocalTime().ToString("g")</td></tr>
        }
        @if (agents.Count == 0) { <tr><td colspan="5" class="text-muted">No registered agents.</td></tr> }
        </tbody>
    </table></div>
</section>
