@model CertificateDiscovery.Web.Models.UserProfileViewModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="page-heading">
    <div>
        <h2>User Profile</h2>
        <div class="text-muted">Manage your display name and password.</div>
    </div>
</div>

@if (TempData["ProfileMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["ProfileError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row g-3">
    <div class="col-lg-5">
        <section class="panel h-100">
            <div class="panel-header">
                <h2>Account</h2>
                <span class="badge @(Model.Role == "Admin" ? "status-critical" : "status-neutral")">@Model.Role</span>
            </div>
            <div class="panel-body">
                <form method="post" asp-action="UpdateProfile" class="asset-form p-0">
                    <div class="mb-3">
                        <label class="form-label" asp-for="UserName">User name</label>
                        <input class="form-control" asp-for="UserName" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="DisplayName">Display name</label>
                        <input class="form-control" asp-for="DisplayName" autocomplete="name" />
                    </div>
                    <button class="btn btn-primary">Save Profile</button>
                </form>
            </div>
        </section>
    </div>

    <div class="col-lg-7">
        <section class="panel h-100">
            <div class="panel-header"><h2>Change Password</h2></div>
            <div class="panel-body">
                <form method="post" asp-action="ChangePassword" class="asset-form p-0">
                    <input type="hidden" asp-for="UserName" />
                    <input type="hidden" asp-for="DisplayName" />
                    <input type="hidden" asp-for="Role" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" asp-for="CurrentPassword">Current password</label>
                            <input class="form-control" asp-for="CurrentPassword" type="password" autocomplete="current-password" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="NewPassword">New password</label>
                            <input class="form-control" asp-for="NewPassword" type="password" autocomplete="new-password" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="ConfirmPassword">Confirm password</label>
                            <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                        </div>
                    </div>
                    <hr />
                    <button class="btn btn-primary">Change Password</button>
                </form>
            </div>
        </section>
    </div>
</div>
