@model CertificateDiscovery.Domain.Entities.ScanJob
@{
    ViewData["Title"] = "Scan Job Detail";
}

<div class="page-heading">
    <div>
        <h2>Scan Job Detail</h2>
        <div class="text-muted">@Model.Id</div>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back to jobs</a>
</div>

<section class="panel">
    <div class="panel-header"><h2>Summary</h2></div>
    <div class="panel-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">Status</dt><dd class="col-sm-10">@Model.Status</dd>
            <dt class="col-sm-2">Trigger</dt><dd class="col-sm-10">@Model.TriggerType</dd>
            <dt class="col-sm-2">Worker</dt><dd class="col-sm-10">@Model.WorkerId</dd>
            <dt class="col-sm-2">Error</dt><dd class="col-sm-10">@Model.ErrorMessage</dd>
        </dl>
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <h2>Asset Results</h2>
        <span class="text-muted">@Model.Results.Count records</span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead><tr><th>Asset</th><th>Status</th><th>Completed</th><th>Duration</th><th>IP</th><th>TLS</th><th>Cipher</th><th>Error</th><th>Message</th></tr></thead>
            <tbody>
            @foreach (var result in Model.Results.OrderBy(x => x.CompletedAtUtc))
            {
                <tr>
                    <td><a asp-controller="Assets" asp-action="Details" asp-route-id="@result.AssetId">@result.Asset.Name</a></td>
                    <td>@result.Status</td>
                    <td>@result.CompletedAtUtc.ToLocalTime().ToString("g")</td>
                    <td>@result.DurationMilliseconds ms</td>
                    <td>@result.ResolvedIpAddress</td>
                    <td>@result.TlsProtocol</td>
                    <td>@result.CipherSuite</td>
                    <td>@result.ErrorType</td>
                    <td>@result.ErrorMessage</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
