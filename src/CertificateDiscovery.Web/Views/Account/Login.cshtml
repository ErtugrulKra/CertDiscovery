@model CertificateDiscovery.Web.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Certificate Discovery</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-page">
        <form class="auth-card" method="post">
            <div class="d-flex align-items-center gap-2 mb-4">
                <span class="brand-mark">CD</span>
                <div>
                    <h1 class="h4 mb-0">Certificate Discovery</h1>
                    <div class="text-muted">Sign in to continue</div>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label class="form-label" asp-for="UserName">User name</label>
                <input class="form-control" asp-for="UserName" autocomplete="username" autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Password">Password</label>
                <input class="form-control" asp-for="Password" type="password" autocomplete="current-password" />
            </div>
            <button class="btn btn-primary w-100">Login</button>

            <div class="text-muted mt-3 small">Initial user: Admin / Admin123</div>
        </form>
    </div>
</body>
</html>
