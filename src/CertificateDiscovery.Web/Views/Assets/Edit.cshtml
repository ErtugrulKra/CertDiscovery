@model CertificateDiscovery.Contracts.AssetUpdateRequest
@{
    ViewData["Title"] = "Edit Asset";
}

<h1 class="h3 mb-3">Edit Asset</h1>
<form method="post" class="asset-form">
    <partial name="_AssetFields" model="Model" />
    <button class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
