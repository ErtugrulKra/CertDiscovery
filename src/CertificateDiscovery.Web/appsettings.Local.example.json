{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=certificate-discovery.db"
  },
  "CertificateDiscovery": {
    "WorkerApiKey": "dev-worker-key-change-me",
    "SchedulerEnabled": true,
    "DefaultScanIntervalMinutes": 1440,
    "ExpireAttentionDays": 60,
    "ExpireWarningDays": 30,
    "ExpireCriticalDays": 7,
    "MaxConcurrentScans": 10,
    "ApplyMigrationsOnStartup": true,
    "DataProtectionKeysPath": ".keys",
    "OpenTelemetry": {
      "ServiceName": "certificate-discovery",
      "OtlpEndpoint": ""
    }
  }
}
