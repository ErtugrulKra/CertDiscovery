ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Data Source=/data/certificate-discovery.db
CertificateDiscovery__WorkerApiKey=change-me-worker-api-key
CertificateDiscovery__SchedulerEnabled=true
CertificateDiscovery__DefaultScanIntervalMinutes=1440
CertificateDiscovery__ExpireAttentionDays=60
CertificateDiscovery__ExpireWarningDays=30
CertificateDiscovery__ExpireCriticalDays=7
CertificateDiscovery__MaxConcurrentScans=10
CertificateDiscovery__ApplyMigrationsOnStartup=true
CertificateDiscovery__DataProtectionKeysPath=/data/dp-keys
CertificateDiscovery__OpenTelemetry__ServiceName=certificate-discovery
CertificateDiscovery__OpenTelemetry__OtlpEndpoint=
WORKER_API_BASE_URL=http://certificate-web:8080
WORKER_API_KEY=change-me-worker-api-key
WORKER_NAME=certificate-worker-1
WORKER_MAX_CONCURRENCY=5
WORKER_POLL_INTERVAL_SECONDS=15
WORKER_REQUEST_TIMEOUT_SECONDS=30
RANGE_WORKER_NAME=certificate-range-worker-1
RANGE_WORKER_MAX_CONCURRENCY=100
RANGE_WORKER_POLL_INTERVAL_SECONDS=10
