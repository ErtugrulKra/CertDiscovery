FROM ubuntu:24.04
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openssh-server nginx openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd /root/.ssh /etc/nginx/tls \
    && chmod 700 /root/.ssh \
    && openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=localhost \
       -keyout /etc/nginx/tls/private-key.pem -out /etc/nginx/tls/certificate.pem \
    && cp /etc/nginx/tls/certificate.pem /etc/nginx/tls/fullchain.pem \
    && cp /etc/nginx/tls/certificate.pem /etc/nginx/tls/chain.pem
COPY nginx.conf /etc/nginx/nginx.conf
COPY systemctl-nginx /usr/local/bin/systemctl
COPY entrypoint.sh /entrypoint.sh
RUN chmod 755 /usr/local/bin/systemctl /entrypoint.sh
EXPOSE 22 443
ENTRYPOINT ["/entrypoint.sh"]
